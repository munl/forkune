      No `zero` item: English ICU plural rules route 0 to `other`, so a `zero` entry here
      would be dead and a same-day pick would read "0 days ago". The View special-cases
      0 with home_today instead.
    -->
    <!-- Positional %1$d, not bare %d: Compose Resources only substitutes indexed
         placeholders, so "%d days ago" renders the literal "%d". -->
    <plurals name="home_days_ago">
        <item quantity="one">%1$d day ago</item>
        <item quantity="other">%1$d days ago</item>
